@model InternFiesta.Models.StudentProfile

@{
    ViewData["Title"] = "CV Preview";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>
            <h2 class="fw-bold mb-1">CV Preview</h2>
            <p class="text-muted mb-0">
                Review your information and save your CV as PDF.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="StudentProfile"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Edit Profile
            </a>

            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">
                Print / Save as PDF
            </button>

        </div>
    </div>


    <div class="card border-0 shadow-sm cv-document">

        <div class="card-body p-5">

            <div class="text-center border-bottom pb-4 mb-4">

                <h1 class="fw-bold mb-2">
                    Curriculum Vitae
                </h1>

                <p class="text-muted mb-0">
                    Generated through InternFiesta
                </p>

            </div>


            <section class="mb-4">

                <h4 class="fw-bold border-bottom pb-2">
                    Academic Information
                </h4>

                <div class="row mt-3">

                    <div class="col-md-6 mb-2">
                        <strong>Student ID:</strong>
                        @Model.StudentId
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Department:</strong>
                        @Model.Department
                    </div>

                    <div class="col-md-6">
                        <strong>CGPA:</strong>
                        @(Model.CGPA?.ToString("0.00") ?? "Not provided")
                    </div>

                </div>

            </section>


            <section class="mb-4">

                <h4 class="fw-bold border-bottom pb-2">
                    Skills
                </h4>

                <p class="mt-3" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Skills)
                        ? "No skills added."
                        : Model.Skills)
                </p>

            </section>


            <section class="mb-4">

                <h4 class="fw-bold border-bottom pb-2">
                    Projects
                </h4>

                <p class="mt-3" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Projects)
                        ? "No projects added."
                        : Model.Projects)
                </p>

            </section>


            <section>

                <h4 class="fw-bold border-bottom pb-2">
                    Experience
                </h4>

                <p class="mt-3" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Experience)
                        ? "No experience added."
                        : Model.Experience)
                </p>

            </section>

        </div>
    </div>

</div>


<style>

    @@media print {

        .no-print,
        header,
        footer {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }

        .cv-document {
            border: none !important;
            box-shadow: none !important;
        }

    }

</style>