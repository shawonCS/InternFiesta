<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - InternFiesta</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/InternFiesta.styles.css"
          asp-append-version="true" />
</head>

<body>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">IF</div>

                <div>
                    <h4>InternFiesta</h4>
                    <small>Career Platform</small>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link">
                    <span class="sidebar-icon">⌂</span>
                    Dashboard
                </a>


                @if (User.IsInRole("Student"))
                {
                    <a asp-controller="StudentProfile"
                       asp-action="Index"
                       class="sidebar-link">
                        <span class="sidebar-icon">◉</span>
                        My Profile
                    </a>

                    <a asp-controller="CV"
                       asp-action="Preview"
                       class="sidebar-link">
                        <span class="sidebar-icon">▣</span>
                        My CV
                    </a>
                }


                @if (User.IsInRole("Company"))
                {
                    <a asp-controller="Internships"
                       asp-action="Index"
                       class="sidebar-link">
                        <span class="sidebar-icon">▤</span>
                        Internships
                    </a>
                }

            </nav>


            <div class="sidebar-bottom">

                <div class="sidebar-user">
                    <div class="user-avatar">
                        @(
                            string.IsNullOrWhiteSpace(User.Identity.Name)
                            ? "U"
                            : User.Identity.Name.Substring(0, 1).ToUpper()
                        )
                    </div>

                    <div class="sidebar-user-info">
                        <span>Signed in as</span>
                        <strong>@User.Identity.Name</strong>
                    </div>
                </div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="logout-button">
                        Logout
                    </button>

                </form>

            </div>

        </aside>


        <!-- MAIN AREA -->
        <div class="main-area">

            <header class="topbar">

                <div>
                    <h5 class="mb-0">
                        @ViewData["Title"]
                    </h5>
                </div>

                <div class="topbar-right">

                    @if (User.IsInRole("Student"))
                    {
                        <span class="role-badge">
                            Student
                        </span>
                    }
                    else if (User.IsInRole("Company"))
                    {
                        <span class="role-badge">
                            Company
                        </span>
                    }
                    else if (User.IsInRole("Alumni"))
                    {
                        <span class="role-badge">
                            Alumni
                        </span>
                    }
                    else if (User.IsInRole("FacultySupervisor"))
                    {
                        <span class="role-badge">
                            Faculty
                        </span>
                    }
                    else if (User.IsInRole("UniversityCoordinator"))
                    {
                        <span class="role-badge">
                            Coordinator
                        </span>
                    }
                    else if (User.IsInRole("Administrator"))
                    {
                        <span class="role-badge">
                            Administrator
                        </span>
                    }

                </div>

            </header>


            <main class="main-content">
                @RenderBody()
            </main>

        </div>

    </div>
}
else
{
    <!-- PUBLIC / LOGIN / REGISTER LAYOUT -->

    <header class="public-header">

        <div class="container d-flex justify-content-between align-items-center">

            <a asp-controller="Home"
               asp-action="Index"
               class="public-brand">
                InternFiesta
            </a>

            <div class="d-flex gap-2">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-outline-primary">
                    Login
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-primary">
                    Register
                </a>

            </div>

        </div>

    </header>


    <main class="public-content">
        @RenderBody()
    </main>
}


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>