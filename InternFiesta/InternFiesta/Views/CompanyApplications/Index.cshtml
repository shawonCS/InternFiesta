@model InternFiesta.ViewModels.CompanyApplicationsViewModel

@{
    ViewData["Title"] = "Applications";
}

<div class="page-heading">
    <h2>Applications</h2>

    <p>
        Applicants for @Model.Internship.Title
    </p>
</div>

@if (TempData["InterviewMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["InterviewMessage"]
    </div>
}

@if (TempData["InterviewError"] != null)
{
    <div class="alert alert-warning">
        @TempData["InterviewError"]
    </div>
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["StatusMessage"]
    </div>
}

@if (Model.Applicants.Count == 0)
{
    <div class="alert alert-info">
        No students have applied for this internship yet.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model.Applicants)
        {
            <div class="col-md-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="mb-3">
                            @(item.Student?.FullName ?? "Student")
                        </h5>

                        <p>
                            <strong>Email:</strong>
                            @(item.Student?.Email ?? "Not provided")
                        </p>

                        <p>
                            <strong>Student ID:</strong>
                            @(item.Profile?.StudentId ?? "Not provided")
                        </p>

                        <p>
                            <strong>Department:</strong>
                            @(item.Profile?.Department ?? "Not provided")
                        </p>

                        <p>
                            <strong>CGPA:</strong>
                            @(item.Profile != null
                                ? item.Profile.CGPA.ToString()
                                : "Not provided")
                        </p>

                        <p>
                            <strong>Skills:</strong>
                            @(item.Profile?.Skills ?? "Not provided")
                        </p>

                        <p>
                            <strong>Candidate Match:</strong>

                            @if (item.MatchScore >= 70)
                            {
                                <span class="badge bg-success">
                                    @item.MatchScore% - @item.MatchLabel
                                </span>
                            }
                            else if (item.MatchScore >= 40)
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.MatchScore% - @item.MatchLabel
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.MatchScore% - @item.MatchLabel
                                </span>
                            }
                        </p>

                        <p>
                            <strong>Applied:</strong>
                            @(item.Application.AppliedAt.ToString("dd MMM yyyy"))
                        </p>

                        <p>
                            <strong>Current Status:</strong>

                            @if (item.Application.Status == "Shortlisted")
                            {
                                <span class="badge bg-info text-dark">
                                    Shortlisted
                                </span>
                            }
                            else if (item.Application.Status == "Selected")
                            {
                                <span class="badge bg-success">
                                    Selected
                                </span>
                            }
                            else if (item.Application.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else if (item.Application.Status == "Waitlisted")
                            {
                                <span class="badge bg-warning text-dark">
                                    Waitlisted
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    @item.Application.Status
                                </span>
                            }
                        </p>

                        @if (item.Application.Status == "Shortlisted")
                        {
                            <a asp-controller="Interview"
                               asp-action="Schedule"
                               asp-route-applicationId="@item.Application.Id"
                               class="btn btn-primary mb-3">
                                Schedule / Reschedule Interview
                            </a>
                        }

                        <hr />

                        <form asp-controller="CompanyApplications"
                              asp-action="UpdateStatus"
                              method="post"
                              class="d-flex flex-wrap gap-2">

                            <input type="hidden"
                                   name="applicationId"
                                   value="@item.Application.Id" />

                            <button type="submit"
                                    name="status"
                                    value="Shortlisted"
                                    class="btn btn-info">
                                Shortlist
                            </button>

                            <button type="submit"
                                    name="status"
                                    value="Selected"
                                    class="btn btn-success">
                                Select
                            </button>

                            <button type="submit"
                                    name="status"
                                    value="Rejected"
                                    class="btn btn-danger">
                                Reject
                            </button>

                            <button type="submit"
                                    name="status"
                                    value="Waitlisted"
                                    class="btn btn-warning">
                                Waitlist
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}