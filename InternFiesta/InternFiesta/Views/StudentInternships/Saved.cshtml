
@model IEnumerable<InternFiesta.Models.SavedInternship>
@using Microsoft.EntityFrameworkCore
@inject InternFiesta.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Saved Internships";

    var companyIds = (Model ?? Enumerable.Empty<InternFiesta.Models.SavedInternship>())
        .Where(s => s.InternshipPosting != null)
        .Select(s => s.InternshipPosting!.CompanyUserId)
        .Distinct()
        .ToList();

    var companies = await DbContext.Users
        .AsNoTracking()
        .Where(u => companyIds.Contains(u.Id))
        .Select(u => new
        {
            u.Id,
            u.FullName,
            u.ProfilePhotoFileName
        })
        .ToDictionaryAsync(u => u.Id);
}


<div class="page-heading">
    <h2>Saved Internships</h2>
    <p>View internships you saved for later.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You have not saved any internships yet.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var saved in Model)
        {
            if (saved.InternshipPosting != null)
            {
                <div class="col-md-6">

                    <div class="card h-100">

                        <div class="card-body">
                            
                            @{
                                companies.TryGetValue(
                                    saved.InternshipPosting.CompanyUserId,
                                    out var company);
                            }

                            <div class="d-flex align-items-center gap-3 mb-3">

                                @if (company != null &&
                                     !string.IsNullOrWhiteSpace(company.ProfilePhotoFileName))
                                {
                                    <img src="@Url.Action("Photo", "ProfilePhotos",
                                                 new { id = company.Id })"
                                         alt="Company Profile Picture"
                                         class="rounded-circle border"
                                         style="width:55px;height:55px;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white
                                                d-flex align-items-center justify-content-center"
                                         style="width:55px;height:55px;font-size:24px;flex-shrink:0;">
                                        @(string.IsNullOrWhiteSpace(company?.FullName)
                                            ? "C"
                                            : company.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }

                                <div>
                                    <strong>
                                        @(company?.FullName ?? "Company")
                                    </strong>
                                    <div class="text-muted small">
                                        Internship posted by
                                    </div>
                                </div>

                            </div>


                            <h4 class="card-title">
                                @saved.InternshipPosting.Title
                            </h4>

                            <p>
                                <strong>Location:</strong>
                                @saved.InternshipPosting.Location
                            </p>

                            <p>
                                <strong>Required Skills:</strong>
                                @saved.InternshipPosting.RequiredSkills
                            </p>

                            <p>
                                <strong>Deadline:</strong>
                                @saved.InternshipPosting.Deadline.ToString("dd MMM yyyy")
                            </p>

                            <p class="text-muted">
                                @saved.InternshipPosting.Description
                            </p>

                        </div>

                        <div class="card-footer bg-transparent">

                            <form asp-controller="StudentInternships"
                                  asp-action="RemoveSaved"
                                  asp-route-id="@saved.Id"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    Remove
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }
        }

    </div>
}