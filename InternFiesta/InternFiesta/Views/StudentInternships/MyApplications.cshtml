
@model IEnumerable<InternFiesta.Models.InternshipApplication>
@using Microsoft.EntityFrameworkCore
@inject InternFiesta.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "My Applications";

    var companyIds = (Model ?? Enumerable.Empty<InternFiesta.Models.InternshipApplication>())
        .Where(a => a.InternshipPosting != null)
        .Select(a => a.InternshipPosting!.CompanyUserId)
        .Distinct()
        .ToList();

    var companies = await DbContext.Users
        .AsNoTracking()
        .Where(u => companyIds.Contains(u.Id))
        .Select(u => new
        {
            u.Id,
            u.FullName,
            u.ProfilePhotoFileName
        })
        .ToDictionaryAsync(u => u.Id);
}


<div class="page-heading">
    <h2>My Applications</h2>
    <p>Track the current status of your internship applications.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You have not applied for any internships yet.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var application in Model)
        {
            <div class="col-md-6">

                <div class="card h-100">

                    <div class="card-body">
                        
                        @{
                            var companyUserId = application.InternshipPosting?.CompanyUserId;

                            var company = companyUserId != null &&
                                          companies.TryGetValue(companyUserId, out var foundCompany)
                                          ? foundCompany
                                          : null;
                        }

                        <div class="d-flex align-items-center gap-3 mb-3">

                            @if (company != null &&
                                 !string.IsNullOrWhiteSpace(company.ProfilePhotoFileName))
                            {
                                <img src="@Url.Action("Photo", "ProfilePhotos",
                                             new { id = company.Id })"
                                     alt="Company Profile Picture"
                                     class="rounded-circle border"
                                     style="width:55px;height:55px;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary text-white
                                            d-flex align-items-center justify-content-center"
                                     style="width:55px;height:55px;font-size:24px;flex-shrink:0;">
                                    @(string.IsNullOrWhiteSpace(company?.FullName)
                                        ? "C"
                                        : company.FullName.Substring(0, 1).ToUpper())
                                </div>
                            }

                            <div>
                                <strong>
                                    @(company?.FullName ?? "Company")
                                </strong>

                                <div class="text-muted small">
                                    Internship posted by
                                </div>
                            </div>

                        </div>


                        <h4 class="card-title">
                            @application.InternshipPosting?.Title
                        </h4>

                        <p>
                            <strong>Location:</strong>
                            @application.InternshipPosting?.Location
                        </p>

                        <p>
                            <strong>Applied:</strong>
                            @application.AppliedAt.ToString("dd MMM yyyy")
                        </p>
                         <p>
                            <strong>Status:</strong>

                                @if (application.Status == "Applied")
                                {
                                    <span class="badge bg-primary">
                                        Applied
                                    </span>
                                }
                                else if (application.Status == "Shortlisted")
                                {
                                    <span class="badge bg-info text-dark">
                                        Shortlisted
                                    </span>
                                }
                                else if (application.Status == "Selected")
                                {
                                    <span class="badge bg-success">
                                        Selected
                                    </span>
                                }
                                else if (application.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else if (application.Status == "Waitlisted")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Waitlisted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @application.Status
                                    </span>
                                }
                            </p>
                        @if (application.Status == "Selected")
                        {
                            <a asp-controller="AcademicProgress"
                               asp-action="SubmitProgress"
                               asp-route-id="@application.Id"
                               class="btn btn-primary">
                                Submit Progress &amp; Evidence
                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}