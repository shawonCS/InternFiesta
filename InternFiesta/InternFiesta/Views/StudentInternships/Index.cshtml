@model IEnumerable<InternFiesta.Models.InternshipPosting>

@{
    ViewData["Title"] = "Internship Opportunities";
}

<div class="page-heading">
    <h2>Internship Opportunities</h2>
    <p>Browse available internship opportunities.</p>
</div>

<div class="card mb-4">
    <div class="card-body">

        <form method="get" class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Title</label>

                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       class="form-control"
                       placeholder="Search by internship title" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Location</label>

                <input type="text"
                       name="location"
                       value="@Context.Request.Query["location"]"
                       class="form-control"
                       placeholder="Location" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Skills</label>

                <input type="text"
                       name="skills"
                       value="@Context.Request.Query["skills"]"
                       class="form-control"
                       placeholder="Required skills" />
            </div>

            <div class="col-md-3 d-flex align-items-end">

                <div class="d-flex gap-2 w-100">

                    <button type="submit"
                            class="btn btn-primary flex-fill">
                        Search
                    </button>

                    <a asp-controller="StudentInternships"
                       asp-action="Index"
                       class="btn btn-outline-secondary flex-fill">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No internship opportunities are currently available.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var internship in Model)
        {
            <div class="col-md-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h4 class="card-title">
                            @internship.Title
                        </h4>

                        <p>
                            <strong>Location:</strong>
                            @internship.Location
                        </p>

                        <p>
                            <strong>Required Skills:</strong>
                            @internship.RequiredSkills
                        </p>

                        <p>
                            <strong>Positions:</strong>
                            @internship.Positions
                        </p>

                        <p>
                            <strong>Deadline:</strong>
                            @internship.Deadline.ToString("dd MMM yyyy")
                        </p>

                        <p class="text-muted">
                            @internship.Description
                        </p>

                    </div>

                    <div class="card-footer bg-transparent">

                        <button type="button"
                                class="btn btn-outline-primary"
                                disabled>
                            Apply
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled>
                            Save
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>
}