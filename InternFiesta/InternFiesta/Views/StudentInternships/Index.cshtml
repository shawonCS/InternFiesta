@model IEnumerable<InternFiesta.Models.InternshipPosting>

@{
    ViewData["Title"] = "Internship Opportunities";
}

<div class="page-heading">
    <h2>Internship Opportunities</h2>
    <p>Browse available internship opportunities.</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text"
                       name="search"
                       class="form-control"
                       placeholder="Search by title or skills" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Location</label>
                <input type="text"
                       name="location"
                       class="form-control"
                       placeholder="Location" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Skills</label>
                <input type="text"
                       name="skills"
                       class="form-control"
                       placeholder="Required skills" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit"
                        class="btn btn-primary w-100">
                    Search
                </button>
            </div>

        </form>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No internship opportunities are currently available.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var internship in Model)
        {
            <div class="col-md-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h4 class="card-title">
                            @internship.Title
                        </h4>

                        <p>
                            <strong>Location:</strong>
                            @internship.Location
                        </p>

                        <p>
                            <strong>Required Skills:</strong>
                            @internship.RequiredSkills
                        </p>

                        <p>
                            <strong>Positions:</strong>
                            @internship.Positions
                        </p>

                        <p>
                            <strong>Deadline:</strong>
                            @internship.Deadline.ToString("dd MMM yyyy")
                        </p>

                        <p class="text-muted">
                            @internship.Description
                        </p>

                    </div>

                    <div class="card-footer bg-transparent">

                        <button type="button"
                                class="btn btn-outline-primary"
                                disabled>
                            Apply
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled>
                            Save
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>
}