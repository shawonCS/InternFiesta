
@model InternFiesta.Controllers.JobFairsController.BoothForm

@{
    ViewData["Title"] = "Company Booth Profile";
    int fairId = ViewBag.JobFairId;
}

<div class="container-fluid px-0">

    <h2>Company Booth Profile</h2>

    <p class="text-muted">
        Job Fair: @ViewBag.JobFairTitle
    </p>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Booth"
                  asp-route-id="@fairId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="BoothName"
                           class="form-label">
                        Booth Name
                    </label>

                    <input asp-for="BoothName"
                           class="form-control"
                           maxlength="150"
                           placeholder="e.g. Tech Company Recruitment Booth" />

                    <span asp-validation-for="BoothName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                        Company Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Describe your company and job opportunities."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactEmail"
                           class="form-label">
                        Contact Email
                    </label>

                    <input asp-for="ContactEmail"
                           type="email"
                           class="form-control"
                           maxlength="200" />

                    <span asp-validation-for="ContactEmail"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BoothLocation"
                           class="form-label">
                        Booth Location (Optional)
                    </label>

                    <input asp-for="BoothLocation"
                           class="form-control"
                           maxlength="100"
                           placeholder="e.g. Booth B-05" />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Booth Profile
                </button>

                <a asp-action="Details"
                   asp-route-id="@fairId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>
