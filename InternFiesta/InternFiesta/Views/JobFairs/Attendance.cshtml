
@model InternFiesta.Controllers.JobFairsController.AttendancePage

@{
    ViewData["Title"] = "Job Fair Attendance";

    var canMark = DateTime.UtcNow >= Model.Fair.StartsAtUtc;

    var total = Model.Registrations.Count;

    var attended = Model.Registrations
        .Count(r => r.AttendedAtUtc != null);
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between
                align-items-center mb-4">
        <div>
            <h2>Job Fair Attendance</h2>
            <p class="text-muted">@Model.Fair.Title</p>
        </div>

        <a asp-controller="CoordinatorJobFairs"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h5>Total Registered</h5>
                <h2>@total</h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3">
                <h5>Attendance Marked</h5>
                <h2>@attended</h2>
            </div>
        </div>
    </div>

    @if (!canMark)
    {
        <div class="alert alert-info">
            Attendance can be marked after the event starts.
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var registration in Model.Registrations)
                        {
                            <tr>
                                <td>
                                    @(registration.User?.FullName ??
                                      registration.UserId)
                                </td>

                                <td>@registration.ParticipantRole</td>

                                <td>
                                    @if (registration.AttendedAtUtc != null)
                                    {
                                        <span class="badge bg-success">
                                            Present
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Marked
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (registration.AttendedAtUtc == null &&
                                         canMark)
                                    {
                                        <form asp-action="MarkAttendance"
                                              asp-route-registrationId="@registration.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Mark Present
                                            </button>
                                        </form>
                                    }
                                    else if (registration.AttendedAtUtc != null)
                                    {
                                        <span class="text-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not available</span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>

            @if (!Model.Registrations.Any())
            {
                <p class="text-center text-muted">
                    No participants have registered yet.
                </p>
            }

        </div>
    </div>
</div>
