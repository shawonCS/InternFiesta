@model InternFiesta.Models.InternshipPosting

@{
    ViewData["Title"] = "Create Internship";
}

<div class="page-heading">
    <h2>Create Internship</h2>
    <p>Add a new internship opportunity for students.</p>
</div>

<div class="row">
    <div class="col-lg-8">

        <div class="card">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="e.g. Software Engineering Intern" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the internship opportunity"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequiredSkills"
                               class="form-label"></label>

                        <input asp-for="RequiredSkills"
                               class="form-control"
                               placeholder="e.g. C#, ASP.NET Core, SQL, Git" />
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Location"
                                   class="form-label"></label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="e.g. Dhaka" />

                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Positions"
                                   class="form-label"></label>

                            <input asp-for="Positions"
                                   class="form-control"
                                   min="1"
                                   max="100" />

                            <span asp-validation-for="Positions"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Deadline"
                                   class="form-label"></label>

                            <input asp-for="Deadline"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Deadline"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            Create Internship
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}