@model List<InternFiesta.Models.FacultyEvaluation>

@{
    ViewData["Title"] = "My Internship Evaluation";
}

<div class="container-fluid py-4">

    <h2 class="mb-1">My Internship Evaluation</h2>

    <p class="text-muted mb-4">
        View your final academic internship grades,
        faculty comments and completed tasks.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No faculty evaluation has been published
            for your selected internships yet.
        </div>
    }
    else
    {
        @foreach (var evaluation in Model)
        {
            var internship = evaluation.AcademicInternship;

            var posting =
                internship.InternshipApplication.InternshipPosting;

            var totalTasks = internship.AssignedTasks.Count;

            var completedTasks = internship.AssignedTasks
                .Count(t => t.Status == "Completed");

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">

                    <h4 class="mb-3">
                        @(posting?.Title ?? "Internship")
                    </h4>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <p class="text-muted mb-1">
                                    Final Academic Grade
                                </p>

                                <h2 class="text-primary mb-0">
                                    @evaluation.Grade
                                </h2>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <p class="text-muted mb-1">
                                    Completed Tasks
                                </p>

                                <h2 class="mb-0">
                                    @completedTasks / @totalTasks
                                </h2>
                            </div>
                        </div>

                    </div>

                    <h5>Faculty Evaluation Comments</h5>

                    <div class="border rounded p-3 mb-3">
                        @evaluation.Comments
                    </div>

                    <p class="text-muted small mb-0">
                        Evaluated On:
                        @evaluation.EvaluatedAt
                        .AddHours(6)
                        .ToString("dd MMM yyyy, hh:mm tt") BST
                    </p>

                </div>
            </div>
        }
    }
</div>
