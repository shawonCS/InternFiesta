@model InternFiesta.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile Picture";
}
<div class="container py-4" style="max-width:720px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h2 class="h4 mb-2">My Profile Picture</h2>
            <p class="text-muted">Visible to other signed-in InternFiesta users.</p>

            <div class="mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoFileName))
                {
                    <img src="@Url.Action("Photo", "ProfilePhotos", new { id = Model.Id })"
                         alt="Your profile picture" class="rounded-circle border"
                         style="width:130px;height:130px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                         style="width:130px;height:130px;font-size:48px;">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName[..1].ToUpper())
                    </div>
                }
            </div>

            <form asp-controller="ProfilePhotos" asp-action="Upload"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label class="form-label" for="photo">Upload or replace picture</label>
                <input type="file" id="photo" name="photo" class="form-control mb-2"
                       accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                <div class="form-text mb-3">JPG or PNG only. Maximum 2 MB. Automatically cropped to a square.</div>
                <button type="submit" class="btn btn-primary">Save Picture</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoFileName))
            {
                <form asp-controller="ProfilePhotos" asp-action="Remove"
                      method="post" class="mt-3"
                      onsubmit="return confirm('Remove your profile picture?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Remove Picture</button>
                </form>
            }
        </div>
    </div>
</div>
