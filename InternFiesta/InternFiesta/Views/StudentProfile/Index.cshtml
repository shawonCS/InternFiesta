@model InternFiesta.Models.StudentProfile
@using InternFiesta.Services
@{
    ViewData["Title"] = "My Profile";
    var completeness =
        ProfileCompletenessService.Calculate(Model);
}

<div class="page-heading">
    <h2>My Profile</h2>
    <p>
        Manage your academic information, skills,
        projects and experience.
    </p>
</div>

@inject Microsoft.AspNetCore.Identity.UserManager<InternFiesta.Models.ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="card mb-4">
    <div class="card-body p-4">

        <h5 class="mb-3">Profile Picture</h5>

        <div class="d-flex align-items-center gap-4 mb-3">

            @if (currentUser != null &&
                 !string.IsNullOrWhiteSpace(currentUser.ProfilePhotoFileName))
            {
                <img src="@Url.Action("Photo", "ProfilePhotos",
                    new { id = currentUser.Id })"
                     alt="My Profile Picture"
                     class="rounded-circle border"
                     style="width:110px;height:110px;object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white
                            d-flex align-items-center justify-content-center"
                     style="width:110px;height:110px;font-size:40px;
                            flex-shrink:0;">
                    @((currentUser?.FullName ?? currentUser?.UserName ?? "U")
                        .Substring(0, 1).ToUpper())
                </div>
            }

            <div>
                <h6 class="mb-1">
                    @(currentUser?.FullName ?? "Student")
                </h6>
                <p class="text-muted mb-0">
                    @(currentUser?.Email ?? "")
                </p>
            </div>

        </div>

        <form asp-controller="ProfilePhotos"
              asp-action="Upload"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

           <label class="form-label">
                Upload or replace picture
            </label>

            <input type="file"
                   name="photo"
                   class="form-control mb-2"
                   accept=".jpg,.jpeg,.png"
                   required />

            <div class="form-text mb-3">
                JPG or PNG images only & max 5mb.
            </div>

            <button type="submit" class="btn btn-primary">
                Save Picture
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(currentUser?.ProfilePhotoFileName))
        {
            <form asp-controller="ProfilePhotos"
                  asp-action="Remove"
                  method="post"
                  class="mt-2">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Remove Picture
                </button>
            </form>
        }

    </div>
</div>

<div class="card mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">
                Profile / CV Completeness
            </h5>

            <strong>
                @completeness.Percentage%
            </strong>
        </div>

        <div class="progress mb-3"
             style="height: 10px;">

            <div class="progress-bar"
                 role="progressbar"
                 style="width: @(completeness.Percentage)%"
                 aria-valuenow="@completeness.Percentage"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>

        @if (completeness.MissingFields.Count == 0)
        {
            <div class="alert alert-success mb-0">
                Your profile is complete.
            </div>
        }
        else
        {
            <p class="mb-2">
                <strong>Missing information:</strong>
            </p>

            <ul class="mb-3">
                @foreach (var field in completeness.MissingFields)
                {
                    <li>@field</li>
                }
            </ul>

            @if (!completeness.CanApply)
            {
                <div class="alert alert-warning mb-0">
                    Complete the required fields before applying for internships:
                    <strong>
                        @string.Join(", ",
                            completeness.MissingRequiredFields)
                    </strong>
                </div>
            }
            else
            {
                <div class="alert alert-success mb-0">
                    Your required profile information is complete.
                    You can apply for internships.
                </div>
            }
        }

    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="row">
    <div class="col-xl-9 col-lg-10">

        <div class="card">
            <div class="card-body p-4">

                <form asp-action="Save" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="StudentId"
                                   class="form-label">
                                Student ID
                            </label>

                            <input asp-for="StudentId"
                                   class="form-control"
                                   placeholder="Enter your student ID" />

                            <span asp-validation-for="StudentId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department"
                                   class="form-label">
                                Department
                            </label>

                            <input asp-for="Department"
                                   class="form-control"
                                   placeholder="e.g. CSE" />

                            <span asp-validation-for="Department"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CGPA"
                                   class="form-label">
                                CGPA
                            </label>

                            <input asp-for="CGPA"
                                   class="form-control"
                                   step="0.01"
                                   min="0"
                                   max="4"
                                   placeholder="e.g. 3.75" />

                            <span asp-validation-for="CGPA"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Skills"
                                   class="form-label">
                                Skills
                            </label>

                            <textarea asp-for="Skills"
                                      class="form-control"
                                      rows="3"
                                      placeholder="e.g. C#, ASP.NET Core, SQL Server, Git"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Projects"
                                   class="form-label">
                                Projects
                            </label>

                            <textarea asp-for="Projects"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your important projects"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Experience"
                                   class="form-label">
                                Experience
                            </label>

                            <textarea asp-for="Experience"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Internships, volunteering, work experience, etc."></textarea>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Profile
                        </button>

                        <a asp-controller="CV"
                           asp-action="Preview"
                           class="btn btn-primary">
                            Preview CV
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}