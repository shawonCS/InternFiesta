@model InternFiesta.Models.StudentProfile

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-heading">
    <h2>My Profile</h2>
    <p>
        Manage your academic information, skills,
        projects and experience.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="row">
    <div class="col-xl-9 col-lg-10">

        <div class="card">
            <div class="card-body p-4">

                <form asp-action="Save" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="StudentId"
                                   class="form-label">
                                Student ID
                            </label>

                            <input asp-for="StudentId"
                                   class="form-control"
                                   placeholder="Enter your student ID" />

                            <span asp-validation-for="StudentId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department"
                                   class="form-label">
                                Department
                            </label>

                            <input asp-for="Department"
                                   class="form-control"
                                   placeholder="e.g. CSE" />

                            <span asp-validation-for="Department"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CGPA"
                                   class="form-label">
                                CGPA
                            </label>

                            <input asp-for="CGPA"
                                   class="form-control"
                                   step="0.01"
                                   min="0"
                                   max="4"
                                   placeholder="e.g. 3.75" />

                            <span asp-validation-for="CGPA"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Skills"
                                   class="form-label">
                                Skills
                            </label>

                            <textarea asp-for="Skills"
                                      class="form-control"
                                      rows="3"
                                      placeholder="e.g. C#, ASP.NET Core, SQL Server, Git"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Projects"
                                   class="form-label">
                                Projects
                            </label>

                            <textarea asp-for="Projects"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your important projects"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Experience"
                                   class="form-label">
                                Experience
                            </label>

                            <textarea asp-for="Experience"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Internships, volunteering, work experience, etc."></textarea>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Profile
                        </button>

                        <a asp-controller="CV"
                           asp-action="Preview"
                           class="btn btn-outline-primary">
                            Preview CV
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}