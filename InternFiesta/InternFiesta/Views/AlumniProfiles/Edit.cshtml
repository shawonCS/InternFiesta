
@model InternFiesta.ViewModels.Alumni.AlumniProfileForm

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="mb-1">Edit Profile</h2>

            <p class="text-muted mb-0">
                Keep your professional information up to date.
            </p>
        </div>

        <a asp-controller="AlumniProfiles"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Profile
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="AlumniProfiles"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <h5 class="mb-3">Profile Information</h5>

                <!-- ACCOUNT INFORMATION -->
                <div class="row g-3 mb-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Full Name
                        </label>

                        <input class="form-control"
                               value="@ViewBag.FullName"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Email
                        </label>

                        <input class="form-control"
                               value="@ViewBag.Email"
                               readonly />
                    </div>
                </div>

                <p class="text-muted small">
                    All professional fields are optional.
                </p>

                <!-- INDUSTRY -->
                <div class="mb-3">
                    <label asp-for="Industry"
                           class="form-label"></label>

                    <input asp-for="Industry"
                           class="form-control"
                           maxlength="100"
                           placeholder="e.g. Information Technology" />

                    <span asp-validation-for="Industry"
                          class="text-danger small"></span>
                </div>

                <!-- JOB TITLE AND COMPANY -->
                <div class="row g-3 mb-3">

                    <div class="col-md-6">
                        <label asp-for="JobTitle"
                               class="form-label"></label>

                        <input asp-for="JobTitle"
                               class="form-control"
                               maxlength="120"
                               placeholder="e.g. Software Engineer" />

                        <span asp-validation-for="JobTitle"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName"
                               class="form-label"></label>

                        <input asp-for="CompanyName"
                               class="form-control"
                               maxlength="150"
                               placeholder="Company or organization" />

                        <span asp-validation-for="CompanyName"
                              class="text-danger small"></span>
                    </div>
                </div>

                <!-- ABOUT -->
                <div class="mb-3">
                    <label asp-for="About"
                           class="form-label"></label>

                    <textarea asp-for="About"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Tell students about your education, experience and career journey."></textarea>

                    <span asp-validation-for="About"
                          class="text-danger small"></span>
                </div>

                <!-- SKILLS -->
                <div class="mb-3">
                    <label asp-for="Skills"
                           class="form-label"></label>

                    <input asp-for="Skills"
                           class="form-control"
                           maxlength="300"
                           placeholder="e.g. C#, SQL Server, Project Management" />

                    <span asp-validation-for="Skills"
                          class="text-danger small"></span>
                </div>

                <!-- LINKEDIN -->
                <div class="mb-4">
                    <label asp-for="LinkedInUrl"
                           class="form-label"></label>

                    <input asp-for="LinkedInUrl"
                           type="url"
                           class="form-control"
                           maxlength="250"
                           placeholder="https://www.linkedin.com/in/yourname" />

                    <span asp-validation-for="LinkedInUrl"
                          class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <!-- PRIVACY AND MENTORING -->
                <h5 class="mb-2">Privacy &amp; Mentoring</h5>

                <p class="text-muted small mb-4">
                    Manage your profile visibility and mentoring
                    availability separately. Changes take effect
                    when you click Save Changes.
                </p>

                <!-- SWITCH 1: PROFILE VISIBILITY -->
                <div class="form-check form-switch mb-4">

                    <input asp-for="IsVisibleToStudents"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="IsVisibleToStudents"
                           class="form-check-label fw-semibold">
                        Show my profile to students
                    </label>

                    <div class="form-text">
                        When enabled, students can find and view
                        your professional profile.
                        Your account email remains private.
                    </div>
                </div>

                <!-- SWITCH 2: MENTORING AVAILABILITY -->
                <div class="form-check form-switch mb-3">

                    <input asp-for="IsAvailableForMentoring"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="IsAvailableForMentoring"
                           class="form-check-label fw-semibold">
                        Available for mentoring
                    </label>

                    <div class="form-text">
                        Indicate whether you are willing to
                        receive mentoring requests from students.
                    </div>
                </div>

                <!-- INFORMATIONAL WARNING -->
                <div id="mentoringVisibilityNotice"
                     class="alert alert-warning mt-3"
                     role="status"
                     hidden>

                    <strong>Mentoring is currently hidden.</strong>

                    <div class="small mt-1">
                        You are available for mentoring, but your
                        profile is private. Students cannot find
                        your profile or send new mentoring requests
                        until you enable profile visibility.
                    </div>
                </div>

                <div class="alert alert-light border mt-3 mb-4">
                    <small>
                        <strong>Note:</strong>
                        Students can send new mentoring requests
                        only when both Profile Visibility and
                        Mentoring Availability are enabled.
                    </small>
                </div>

                <!-- SAVE BUTTONS -->
                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="AlumniProfiles"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const visibility = document.getElementById(
                "IsVisibleToStudents");

            const mentoring = document.getElementById(
                "IsAvailableForMentoring");

            const notice = document.getElementById(
                "mentoringVisibilityNotice");

            function updateNotice() {

                const profileIsPrivate = !visibility.checked;
                const wantsMentoring = mentoring.checked;

                notice.hidden = !(
                    profileIsPrivate && wantsMentoring
                );
            }

            // Independent switches:
            // Only update the informational warning.
            // Do not modify the other checkbox.
            visibility.addEventListener(
                "change", updateNotice);

            mentoring.addEventListener(
                "change", updateNotice);

            // Show the correct warning for saved values.
            updateNotice();
        });
    </script>
}
