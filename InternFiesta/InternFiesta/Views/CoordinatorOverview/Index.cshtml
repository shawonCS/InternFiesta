
@model InternFiesta.ViewModels.Coordinator.CoordinatorOverviewPageViewModel

@{
    ViewData["Title"] = "Coordinator Overview";
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h2 class="mb-1">Coordinator Overview</h2>

            <p class="text-muted mb-0">
                University-wide internship activity and
                academic tracking at a glance.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="AcademicProgress"
               asp-action="AssignFaculty"
               class="btn btn-primary">
                Assign Faculty
            </a>

            <a asp-controller="CoordinatorJobFairs"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Job Fairs
            </a>

        </div>
    </div>

    <!-- SIX SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <!-- STUDENTS -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Students
                    </div>

                    <div class="fs-2 fw-bold text-primary">
                        @Model.Counts.StudentCount.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Registered Student-role users
                    </div>
                </div>
            </div>
        </div>

        <!-- COMPANIES -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Companies
                    </div>

                    <div class="fs-2 fw-bold text-info">
                        @Model.Counts.CompanyCount.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Registered Company-role users
                    </div>
                </div>
            </div>
        </div>

        <!-- INTERNSHIPS -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Internships
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @Model.Counts.InternshipCount.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Non-deleted postings
                    </div>
                </div>
            </div>
        </div>

        <!-- APPLICATIONS -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Applications
                    </div>

                    <div class="fs-2 fw-bold text-warning">
                        @Model.Counts.ApplicationCount.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Submitted applications
                    </div>
                </div>
            </div>
        </div>

        <!-- JOB FAIRS -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Job Fairs
                    </div>

                    <div class="fs-2 fw-bold">
                        @Model.Counts.JobFairCount.ToString("N0")
                    </div>

                    <a asp-controller="CoordinatorJobFairs"
                       asp-action="Index"
                       class="small text-decoration-none">
                        View Job Fairs
                    </a>
                </div>
            </div>
        </div>

        <!-- ACADEMIC PARTICIPANTS -->
        <div class="col-6 col-lg-4 col-xxl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">
                        Academic Participants
                    </div>

                    <div class="fs-2 fw-bold text-primary">
                        @Model.Counts.AcademicParticipationCount.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        Distinct students with an academic internship
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ACADEMIC PARTICIPATION TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 px-4 pt-4 pb-2">

            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-2">

                <div>
                    <h4 class="mb-1">
                        Academic Participation &amp; Status
                    </h4>

                    <p class="text-muted small mb-0">
                        Faculty assignments, student updates,
                        milestones, and evaluation tracking.
                    </p>
                </div>

                <a asp-controller="AcademicProgress"
                   asp-action="AssignFaculty"
                   class="btn btn-sm btn-outline-primary">
                    Open Faculty Assignments
                </a>

            </div>
        </div>

        <div class="card-body p-4">

            @if (Model.AcademicRows.Count == 0)
            {
                <!-- EMPTY STATE -->
                <div class="text-center py-5">

                    <h5 class="mb-2">
                        No academic participation records yet
                    </h5>

                    <p class="text-muted mb-3">
                        Once a selected application has a faculty
                        assignment, its academic tracking
                        information will appear here.
                    </p>

                    <a asp-controller="AcademicProgress"
                       asp-action="AssignFaculty"
                       class="btn btn-primary">
                        Assign Faculty
                    </a>

                </div>
            }
            else
            {
                <!-- TABLE -->
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col">Internship</th>
                                <th scope="col">Faculty</th>
                                <th scope="col">Application</th>
                                <th scope="col">Academic Tracking</th>
                                <th scope="col" class="text-center">
                                    Updates
                                </th>
                                <th scope="col" class="text-center">
                                    Milestones
                                </th>
                                <th scope="col">Assigned</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in Model.AcademicRows)
                            {
                                var trackingBadge = row.TrackingStatus switch
                                {
                                    "Evaluated" => "bg-success",
                                    "Updates Received" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="fw-semibold">
                                        @row.StudentName
                                    </td>

                                    <td>
                                        @row.InternshipTitle
                                    </td>

                                    <td>
                                        @row.FacultyName
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @row.ApplicationStatus
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @trackingBadge">
                                            @row.TrackingStatus
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @row.ProgressUpdateCount
                                    </td>

                                    <td class="text-center">
                                        @row.CompletedMilestoneCount / @row.MilestoneCount
                                    </td>

                                    <td class="text-nowrap">
                                        @row.StartedAtUtc.AddHours(6).ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                @if (Model.TotalAcademicRecords > Model.AcademicRows.Count)
                {
                    <p class="text-muted small mt-3 mb-0">
                        Showing the latest @Model.AcademicRows.Count
                        of @Model.TotalAcademicRecords academic internship records.
                    </p>
                }
            }
        </div>
    </div>

    <p class="text-muted small mt-3 mb-0">
        Counts are supplied by the T-22.1 Coordinator Overview queries.
        Academic tracking is based on progress updates and saved faculty
        evaluations, not an official completion grade.
        Dates are displayed in Bangladesh time (UTC+6).
    </p>

</div>
