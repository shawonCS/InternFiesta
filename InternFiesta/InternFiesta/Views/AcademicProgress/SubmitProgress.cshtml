
@model InternFiesta.Controllers.AcademicProgressController.ProgressForm

@{
    ViewData["Title"] = "Submit Progress Update";

    int internshipId = ViewBag.AcademicInternshipId;

    var history = ViewBag.ProgressHistory as
        List<InternFiesta.Models.AcademicProgressUpdate>
        ?? new List<InternFiesta.Models.AcademicProgressUpdate>();
    var assignedTasks = ViewBag.AssignedTasks as
        List<InternFiesta.Models.AssignedTask>
        ?? new List<InternFiesta.Models.AssignedTask>();
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width:650px;">
        <div class="card-body p-4">

            <h3>Submit Progress Update</h3>

            <p class="text-muted">
                Share your latest academic internship progress.
            </p>

            <form asp-controller="AcademicProgress"
                  asp-action="SubmitProgress"
                  asp-route-id="@internshipId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="AssignedTaskId" class="form-label">
                        Select Assigned Task
                    </label>

                    <select asp-for="AssignedTaskId"
                            class="form-select"
                            required>

                        <option value="">-- Select Task --</option>

                        @foreach (var task in assignedTasks)
                        {
                            <option value="@task.Id">
                                @task.Title
                                (@task.Status)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="AssignedTaskId"
                          class="text-danger"></span>

                    <div class="mt-3">
                        <h6>Assigned Task Details</h6>

                        @foreach (var task in assignedTasks)
                        {
                            <div class="border rounded p-3 mb-2">
                                <strong>@task.Title</strong>

                                <p class="mb-1 mt-2">
                                    <strong>Description:</strong>
                                    @task.Description
                                </p>

                                <p class="mb-1">
                                    <strong>Deadline:</strong>
                                    @(task.DueDate?.ToString("dd MMM yyyy")
                                        ?? "No deadline")
                                </p>

                                <p class="mb-0">
                                    <strong>Status:</strong>
                                    @task.Status
                                </p>
                            </div>
                        }
                    </div>

                    <div class="form-text">
                        Submit your report and evidence for the selected company task.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                        Progress Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"
                              maxlength="2000"
                              placeholder="Describe your completed work, achievements and challenges..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EvidenceFiles"
                           class="form-label">
                        Supporting Documents (Optional)
                    </label>

                    <input asp-for="EvidenceFiles"
                           type="file"
                           class="form-control"
                           multiple
                           accept=".pdf,.docx,.jpg,.jpeg,.png" />

                    <div class="form-text">
                        Maximum 3 files, 5 MB each.
                        PDF, DOCX, JPG and PNG supported.
                    </div>

                    <span asp-validation-for="EvidenceFiles"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Progress &amp; Evidence
                </button>

            </form>

        </div>
    </div>

    <h4 class="mt-4">My Previous Progress Updates</h4>

    @if (!history.Any())
    {
        <p class="text-muted">
            No progress submitted yet.
        </p>
    }
    else
    {

        @foreach (var progress in history)
        {
            <div class="card mb-3">
                <div class="card-body">

                    @if (progress.AssignedTask != null)
                    {
                        <p class="mb-2">
                            <strong>Assigned Task:</strong>
                            @progress.AssignedTask.Title
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-2">
                            Previous Progress Update
                        </p>
                    }

                    <p>@progress.Description</p>

                    <small class="text-muted">
                        @progress.SubmittedAt.AddHours(6).ToString("dd MMM yyyy, hh:mm tt") BST
                    </small>

                    @if (progress.Attachments != null &&
                         progress.Attachments.Any())
                    {
                        <div class="mt-2">
                            <strong>Attachments</strong>

                            <ul>
                                @foreach (var item in progress.Attachments)
                                {
                                    <li>
                                        <a asp-controller="AcademicProgress"
                                           asp-action="DownloadEvidence"
                                           asp-route-id="@item.Id">
                                            @item.OriginalFileName
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                </div>
            </div>
        }
    }
</div>
