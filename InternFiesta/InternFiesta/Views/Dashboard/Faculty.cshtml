@using InternFiesta.Models
@using InternFiesta.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Faculty Dashboard";

    var facultyId = UserManager.GetUserId(User);

    var internships = await DbContext.AcademicInternships
        .AsNoTracking()
        .Where(a => a.FacultyUserId == facultyId)
        .Include(a => a.InternshipApplication)
            .ThenInclude(a => a.Student)
        .Include(a => a.InternshipApplication)
            .ThenInclude(a => a.InternshipPosting)
        .Include(a => a.AssignedTasks)
        .Include(a => a.ProgressUpdates)
        .AsSplitQuery()
        .OrderByDescending(a => a.StartedAt)
        .ToListAsync();

    var assignedStudents = internships.Count;

    var totalTasks = internships.Sum(a =>
        a.AssignedTasks.Count);

    var submittedTasks = internships.Sum(a =>
        a.AssignedTasks.Count(t => t.Status == "Submitted"));

    var completedTasks = internships.Sum(a =>
        a.AssignedTasks.Count(t => t.Status == "Completed"));

    var totalProgress = internships.Sum(a =>
        a.ProgressUpdates.Count);
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Faculty Dashboard</h2>
            <p class="text-muted mb-0">
                Monitor your assigned students, internship tasks
                and academic progress.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Assigned Students
                    </p>

                    <h2 class="mb-0">
                        @assignedStudents
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Total Assigned Tasks
                    </p>

                    <h2 class="mb-0">
                        @totalTasks
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Tasks Awaiting Review
                    </p>

                    <h2 class="mb-0 text-warning">
                        @submittedTasks
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Completed Tasks
                    </p>

                    <h2 class="mb-0 text-success">
                        @completedTasks
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Quick Actions</h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="AcademicProgress"
                   asp-action="FacultyStudents"
                   class="btn btn-primary">
                    Assigned Students Progress
                </a>

                <a asp-controller="AcademicProgress"
                   asp-action="PerformanceMatrix"
                   class="btn btn-outline-primary">
                    Intern Performance Matrix
                </a>

            </div>

        </div>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">

                <div>
                    <h5 class="mb-1">My Assigned Interns</h5>

                    <p class="text-muted small mb-0">
                        View progress reports and assigned task completion.
                    </p>
                </div>

                <span class="badge bg-primary">
                    @totalProgress Progress Updates
                </span>

            </div>

            @if (!internships.Any())
            {
                <div class="alert alert-info mb-0">
                    No students have been assigned to you yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Internship</th>
                                <th>Tasks Completed / Total</th>
                                <th>Awaiting Review</th>
                                <th>Progress Updates</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var internship in internships)
                            {
                                var student =
                                    internship.InternshipApplication.Student;

                                var posting =
                                    internship.InternshipApplication.InternshipPosting;

                                var tasksDone = internship.AssignedTasks
                                    .Count(t => t.Status == "Completed");

                                var tasksAssigned = internship.AssignedTasks.Count;
                                var tasksAwaitingReview = internship.AssignedTasks
                                    .Count(t => t.Status == "Submitted");

                                var progressCount = internship.ProgressUpdates.Count;

                                <tr>

                                    <td>
                                        <strong>
                                            @(student?.FullName ?? "Unknown Student")
                                        </strong>
                                    </td>

                                    <td>
                                        @(posting?.Title ?? "N/A")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @tasksDone / @tasksAssigned
                                        </span>
                                    </td>
                                    <td>
                                        @if (tasksAwaitingReview > 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @tasksAwaitingReview Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                0 Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @progressCount
                                        </span>
                                    </td>

                                    <td>

                                        <a asp-controller="AcademicProgress"
                                           asp-action="FacultyStudentDetails"
                                           asp-route-id="@internship.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            View Progress
                                        </a>

                                        <a asp-controller="FacultyEvaluations"
                                           asp-action="Edit"
                                           asp-route-id="@internship.Id"
                                           class="btn btn-primary btn-sm">
                                            Evaluate
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            }

        </div>

    </div>

</div>
